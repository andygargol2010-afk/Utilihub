{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "git": {
    "deploymentEnabled": {
      "fix/spanish-complete": false
    }
  },
  "redirects": [
    {
      "source": "/es/",
      "destination": "/es",
      "permanent": true
    },
    {
      "source": "/es/herramientas/porcentaje-hasta-meta",
      "destination": "/es/herramientas/calculadora-porcentaje-completado",
      "permanent": true
    },
    {
      "source": "/es/herramientas/porcentaje-de-porcentaje",
      "destination": "/es/herramientas/calculadora-de-porcentajes",
      "permanent": true
    },
    {
      "source": "/es/herramientas/calculadora-tableros",
      "destination": "/es/herramientas/material-por-superficie",
      "permanent": true
    },
    {
      "source": "/tools/arithmetic-sequence-calculator",
      "destination": "/tools/number-sequences",
      "permanent": true
    },
    {
      "source": "/es/herramientas/sucesion-aritmetica",
      "destination": "/es/herramientas/secuencias",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}

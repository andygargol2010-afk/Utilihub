{
  "ignoreCommand": "bash -c \"git rev-parse --verify HEAD^ >/dev/null 2>&1 && git diff --quiet HEAD^ -- . ':!docs' ':!.agent' ':!.github' ':!*.md' || exit 1\"",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
